<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#1E1E1E"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="#2A2A2A"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivMessageIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Message Icon"
            android:src="@drawable/ic_message_24"
            app:tint="#D4AF37" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMessageCustomer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Sarah Connor" />

            <TextView
                android:id="@+id/tvMessageSubject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B0B0B0"
                android:textSize="12sp"
                tools:text="Septum Piercing Aftercare Question" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMessageStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_new"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:textColor="#1E88E5"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="NEW" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
                        android:layout_height="240dp"
                        android:scaleType="centerCrop"
                        android:src="@mipmap/ic_launcher"
                        android:contentDescription="Ear Piercing" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:id="@+id/tvServiceName2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ear Piercing"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/moes_forest_green" />

                        <TextView
                            android:id="@+id/tvProductDesc2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Safe and professional ear piercing with sterile equipment and standard jewelry included."
                            android:textSize="14sp"
                            android:textColor="#555555"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/tvServicePrice2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="R300.00"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/moes_forest_green"
                            android:layout_marginTop="10dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="24dp">

                            <Button
                                android:id="@+id/btnBooking2"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:text="Booking"
                                android:backgroundTint="@color/moes_forest_green"
                                android:textColor="@color/white"
                                app:cornerRadius="8dp" />

                            <Space android:layout_width="match_parent" android:layout_height="12dp" />

                            <Button
                                android:id="@+id/btnAddToCart2"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="56dp"
                                android:text="Add to Cart"
                                android:textColor="@color/moes_forest_green"
                                app:strokeColor="@color/moes_forest_green"
                                app:cornerRadius="8dp" />

                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>

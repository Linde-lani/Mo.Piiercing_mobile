<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/white">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/bg_status_confirmed"
        app:tint="@color/moes_forest_green"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvBookingReceived"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="booking recieved"
        android:textColor="@color/moes_forest_green"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvThankYou"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thank you, User!"
        android:textColor="@color/moes_forest_green"
        android:textSize="18sp"
        android:layout_marginBottom="32dp"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your appointment has been successfully booked."
        android:textColor="@color/moes_forest_green"
        android:textSize="16sp"
        android:layout_marginBottom="48dp"
        android:gravity="center" />

    <Button
        android:id="@+id/btnBackToGallery"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Back to Gallery"
        android:backgroundTint="@color/moes_forest_green"
        android:textColor="@color/white"
        app:cornerRadius="12dp" />

</LinearLayout>
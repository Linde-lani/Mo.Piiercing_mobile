<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/dark_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:strokeColor="@color/moes_gold"
    app:strokeWidth="1dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add New Tattoo"
                android:textColor="@color/moes_gold"
                android:textSize="20sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:background="#33FFFFFF" />

            <!-- Tattoo Name Input -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tattoo Name"
                android:textColorHint="@color/dark_text_secondary"
                app:boxStrokeColor="@color/moes_gold"
                app:hintTextColor="@color/moes_gold">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTattooName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="@color/dark_text_primary" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Description Input -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Description"
                android:textColorHint="@color/dark_text_secondary"
                app:boxStrokeColor="@color/moes_gold"
                app:hintTextColor="@color/moes_gold">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTattooDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:lines="3"
                    android:textColor="@color/dark_text_primary" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Price Input -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Price (ZAR / R)"
                android:textColorHint="@color/dark_text_secondary"
                app:boxStrokeColor="@color/moes_gold"
                app:hintTextColor="@color/moes_gold">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTattooPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/dark_text_primary" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Image URL Input / Upload -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Image URL (or select preset)"
                android:textColorHint="@color/dark_text_secondary"
                app:boxStrokeColor="@color/moes_gold"
                app:hintTextColor="@color/moes_gold">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etTattooImageUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:textColor="@color/dark_text_primary" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Category Selector -->
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Category"
                android:textColorHint="@color/dark_text_secondary"
                app:boxStrokeColor="@color/moes_gold"
                app:hintTextColor="@color/moes_gold">

                <AutoCompleteTextView
                    android:id="@+id/actvTattooCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:text="Tattoos"
                    android:textColor="@color/dark_text_primary" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Toggles: Featured & Active -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchFeatured"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:checked="true"
                android:text="Featured Product"
                android:textColor="@color/dark_text_primary"
                app:thumbTint="@color/moes_gold"
                app:trackTint="#33C69C35" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchActive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:checked="true"
                android:text="Active (Visible in Gallery)"
                android:textColor="@color/dark_text_primary"
                app:thumbTint="@color/moes_forest_green"
                app:trackTint="#331B5E20" />

            <!-- Buttons: Save & Cancel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCancelTattoo"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cancel"
                    android:textColor="@color/dark_text_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSaveTattoo"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/moes_forest_green"
                    android:text="Save Tattoo"
                    android:textColor="@color/white" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="#1E1E1E"
    app:cardCornerRadius="16dp"
    app:strokeColor="#D4AF37"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Tattoo Design"
            android:textColor="#D4AF37"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTattooName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tattoo Name"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/etTattooDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Description"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/etTattooPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Price (R)"
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF" />

        <EditText
            android:id="@+id/etTattooImageUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Image URL"
            android:textColor="#FFFFFF" />

        <AutoCompleteTextView
            android:id="@+id/actvTattooCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Category"
            android:textColor="#FFFFFF" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchFeatured"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Featured"
            android:textColor="#FFFFFF" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchActive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Active"
            android:textColor="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelTattoo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cancel" />

            <Button
                android:id="@+id/btnSaveTattoo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
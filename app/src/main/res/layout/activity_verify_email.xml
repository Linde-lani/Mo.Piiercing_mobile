<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/white"
    tools:context=".VerifyEmailScreen">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvVerifyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verify Your Email"
            android:textColor="@color/moes_forest_green"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvVerifySubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="We have sent a verification email to your address. Please check your inbox and click the link to verify your account."
            android:textSize="16sp"
            android:textAlignment="center"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="32dp" />

        <TextView
            android:id="@+id/tvUserEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnCheckVerification"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="I Have Verified / Check Status"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:layout_marginBottom="16dp"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnResendEmail"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Resend Verification Email"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:backgroundTint="@android:color/darker_gray"
            android:textColor="@color/moes_forest_green"
            android:layout_marginBottom="24dp"
            app:cornerRadius="12dp" />

        <TextView
            android:id="@+id/txtBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log out / Back to Login"
            android:textStyle="bold"
            android:padding="8dp" />

    </LinearLayout>
</ScrollView>

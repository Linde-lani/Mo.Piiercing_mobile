<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardMessage"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/dark_card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/dark_card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Customer Name and Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvCustomerName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/tvStatusBadge"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/dark_text_primary"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Sarah Connor" />

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_badge_new"
                android:gravity="center"
                android:textAllCaps="true"
                android:textColor="@color/status_text_color"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="NEW" />

        </RelativeLayout>

        <!-- Date Submitted -->
        <TextView
            android:id="@+id/tvDateSubmitted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/dark_text_secondary"
            android:textSize="12sp"
            tools:text="Oct 24, 2023 • 10:30 AM" />

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="#33FFFFFF" />

        <!-- Subject -->
        <TextView
            android:id="@+id/tvSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/moes_gold"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Subject: Septum Piercing Aftercare Question" />

        <!-- Email Address -->
        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:drawablePadding="6dp"
            android:textColor="@color/dark_text_secondary"
            android:textSize="13sp"
            app:drawableStartCompat="@android:drawable/ic_dialog_email"
            app:drawableTint="@color/dark_text_secondary"
            tools:text="sarah.c@example.com" />

        <!-- Phone Number -->
        <TextView
            android:id="@+id/tvPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:drawablePadding="6dp"
            android:textColor="@color/dark_text_secondary"
            android:textSize="13sp"
            app:drawableStartCompat="@android:drawable/ic_menu_call"
            app:drawableTint="@color/dark_text_secondary"
            tools:text="+1 (555) 019-2834" />

        <!-- Message Preview (First 2-3 lines) -->
        <TextView
            android:id="@+id/tvMessagePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="@color/dark_text_primary"
            android:textSize="14sp"
            tools:text="Hi there! I got my septum pierced at your studio 3 days ago. I was wondering if I should keep cleaning it with saline spray twice a day..." />

        <!-- Divider line before buttons -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="#22FFFFFF" />

        <!-- Action Buttons Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <!-- View Message Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewMessage"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="View"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:strokeColor="@color/moes_gold" />

            <!-- Mark as Read Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkRead"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Mark Read"
                android:textColor="@color/status_read_bg"
                android:textSize="12sp" />

            <!-- Mark as Resolved Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMarkResolved"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/status_resolved_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Resolve"
                android:textColor="@color/white"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

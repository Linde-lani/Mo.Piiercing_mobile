<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardAdminProduct"
    android:layout_width="160dp"
    android:layout_height="240dp"
    android:layout_marginStart="8dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/dark_card_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/dark_card_stroke"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/ivProductImage"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:scaleType="centerCrop"
            android:src="@drawable/sparkle_motion" />

        <!-- Overflow Menu Button (Three Dots) -->
        <ImageButton
            android:id="@+id/btnOverflowMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_margin="6dp"
            android:background="#A6000000"
            android:contentDescription="Options"
            android:padding="6dp"
            android:src="@android:drawable/ic_menu_more"
            app:tint="@color/white" />

        <!-- Status Badges Layout -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_margin="6dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/badgeFeatured"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_new"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="FEATURED"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/badgeLowStock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_badge_read"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="LOW STOCK"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/badgeHidden"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_badge_declined"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="HIDDEN"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/ivProductImage"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/dark_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Titanium Nose Ring" />

            <TextView
                android:id="@+id/tvProductCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/dark_text_secondary"
                android:textSize="11sp"
                tools:text="Jewellery" />

            <TextView
                android:id="@+id/tvProductPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/moes_gold"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="R350.00" />

            <TextView
                android:id="@+id/tvStockCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/dark_text_secondary"
                android:textSize="10sp"
                tools:text="Stock: 15 items" />

        </LinearLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>

            android:exported="false" />
        <activity
            android:name=".AdminScreen"
            android:exported="false" />
        <activity
            android:name=".ProfileScreen"
            android:exported="false" />
        <activity
            android:name=".PurchaseScreen"
            android:exported="false" />
        <activity
            android:name=".cart"

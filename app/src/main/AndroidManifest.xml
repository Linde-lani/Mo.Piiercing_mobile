            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ContactUsScreen"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SettingsScreen"
            android:exported="false"
